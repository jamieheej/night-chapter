rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated and owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own journal entries
    match /users/{userId}/journals/{journalId} {
      allow read, write: if isOwner(userId);
    }
    
    // Allow users to read and write their own user profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Deny access to all other documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}